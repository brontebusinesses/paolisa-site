---
/**
 * Page « Petits Craquages » — produits ponctuels hors gamme numérotée et hors
 * solaires : pièces exclusives, en édition limitée, qui « pop » au gré des
 * trouvailles et des collaborations. Cartes = photos des produits.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import NoticeBar from '../components/NoticeBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';
import { craquages } from '../lib/products';
import { isStoreOpen } from '../lib/store-status';

const craquageProducts = craquages();
const craquageCols = Math.min(craquageProducts.length, 4) || 1;
const storeOpen = isStoreOpen();
---

<BaseLayout
  title="Petits Craquages — PAOLISA"
  description="Petits Craquages : les trouvailles ponctuelles Paolisa, en dehors du rituel numéroté et des solaires. Pièces exclusives, en édition limitée."
>
  <NoticeBar message="LIVRAISON OFFERTE DÈS 60 € EN UE · RETOURS SOUS 30 JOURS" />
  <Header transparent={false} currentPath="/petits-craquages" />

  <main>
    <section class="container-paolisa pt-8 md:pt-12 pb-16 md:pb-24">
      <div class="flex items-baseline justify-between flex-wrap gap-4 mb-12 md:mb-16">
        <div class="max-w-2xl">
          <p class="mono-label mb-4">— PETITS CRAQUAGES —</p>
          <h1 class="display-l mb-4">Petits craquages</h1>
          <p class="body-l text-ink-secondary max-w-prose">
            Des trouvailles qui n'ont pas de numéro. En dehors du rituel et des
            solaires, des pièces qui nous plaisent, en édition limitée — on a
            craqué, forcément.
          </p>
        </div>
        <p class="mono-label">[ {craquageProducts.length.toString().padStart(2, '0')} PRODUIT{craquageProducts.length > 1 ? 'S' : ''} ]</p>
      </div>

      <div class="flex items-center gap-4 mb-8">
        <p class="mono-label whitespace-nowrap text-ink-primary">ÉDITION LIMITÉE · AU GRÉ DES TROUVAILLES</p>
        <span class="flex-1 border-t border-line-subtle"></span>
      </div>
      <div
        class="grid w-fit max-w-full gap-px bg-line-faint border border-line-faint"
        style={`grid-template-columns: repeat(${craquageCols}, minmax(200px, 284px));`}
      >
        {
          craquageProducts.map((p) => (
            <ProductCard
              href={p.href}
              image={p.cardImage}
              imageAlt={p.title}
              eyebrow={`PETITS CRAQUAGES / ${p.category}`}
              title={p.title}
              subtitle={p.subtitle}
              price={p.priceLabel}
              status={p.status}
              quickAdd={storeOpen && p.available}
              variantId={p.shopifyVariantId}
              slug={p.slug}
              priceCents={p.priceCents}
              accentColor={p.accentColor}
            />
          ))
        }
      </div>

      <p class="mono-micro text-ink-tertiary mt-8">
        <a href="/gamme" class="hover:opacity-70 transition-opacity duration-150 ease-in-out">← VOIR LE RITUEL COMPLET</a>
      </p>
    </section>
  </main>

  <Footer />
</BaseLayout>
