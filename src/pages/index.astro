---
/**
 * Home — hero éditorial (août 2026).
 * NoticeBar → Header → HeroAccueil → GammeOnglet → OrigineTeaser → TrioBar →
 * Manifesto → CompositionList → JournalTeaser → Footer.
 *
 * La grille de produits ne s'affiche plus en haut de page : le hero pose
 * l'ambiance et envoie vers le diagnostic, la bande « gamme » prend le relais
 * pour ceux qui veulent voir les produits tout de suite.
 *
 * Le compteur d'entrées du journal est calculé à la source : il ne peut plus
 * se désynchroniser du contenu.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NoticeBar from '../components/NoticeBar.astro';
import Header from '../components/Header.astro';
import HeroAccueil from '../components/HeroAccueil.astro';
import GammeOnglet from '../components/GammeOnglet.astro';
import OrigineTeaser from '../components/OrigineTeaser.astro';
import TrioBar from '../components/TrioBar.astro';
import Manifesto from '../components/Manifesto.astro';
import CompositionList from '../components/CompositionList.astro';
import JournalTeaser from '../components/JournalTeaser.astro';
import Footer from '../components/Footer.astro';
import { productList } from '../lib/products';
import { isStoreOpen } from '../lib/store-status';

const storeOpen = isStoreOpen();

const pad = (n: number) => String(n).padStart(2, '0');

/** Compteurs dynamiques — même source que ce qui est réellement affiché. */
const productCount = productList().length;
const journalCount = (await getCollection('journal', ({ data }) => !data.draft)).length;

const trioItems = [
  { label: 'LA GAMME', status: `[ ${pad(productCount)} PRODUITS ]`, href: '/gamme' },
  {
    label: 'N°01 — SÉRUM',
    status: storeOpen ? '[ DISPONIBLE ]' : '[ BIENTÔT ]',
    href: '/produit/serum',
  },
  { label: 'JOURNAL', status: `[ ${pad(journalCount)} ENTRÉES ]`, href: '/journal' },
];

const ingredientPrinciples = [
  { index: '01', name: 'FORMULES COURTES', origin: "Peu d'ingrédients, chacun choisi pour son efficacité" },
  { index: '02', name: 'ACTIFS CIBLÉS', origin: 'Niacinamide, acide hyaluronique, alternative au rétinol' },
  { index: '03', name: 'SOURCÉ AVEC SOIN', origin: 'Extraits naturels (aloe, centella, argousier...) et huiles vierges pressées à froid pour le sérum-huile' },
  { index: '04', name: 'DES ACTIFS DOCUMENTÉS', origin: 'Chaque ingrédient a un rôle, détaillé sur sa fiche' },
  { index: '05', name: 'TRANSPARENCE TOTALE', origin: 'INCI complet sur chaque fiche produit' },
];
---

<BaseLayout
  title="PAOLISA — Le rituel du matin, au complet."
  description="Skincare végane fabriquée en Europe. Sérum éclat, contour des yeux, huile ou crème, protection solaire. Trouvez votre rituel en trois questions."
>
  <NoticeBar message="LIVRAISON UNION EUROPÉENNE · RETOURS SOUS 30 JOURS" />

  <Header transparent={false} currentPath="/" />

  <main>
    <HeroAccueil cta={{ label: 'FAIRE LE DIAGNOSTIC →', href: '/diagnostic' }} />

    <GammeOnglet />

    <OrigineTeaser />

    <TrioBar items={trioItems} />

    <Manifesto
      eyebrow="— MANIFESTE —"
      headlineLine1="Un geste après l'autre."
      headlineLine2="Voilà le rituel."
      body="Du sérum à la protection solaire, six produits qui se répondent. Des formules courtes, des actifs choisis, une intention : prendre soin de soi, simplement."
    />

    <CompositionList
      eyebrow="NOS INGRÉDIENTS"
      subEyebrow="UNE MÊME EXIGENCE, PRODUIT APRÈS PRODUIT"
      ingredients={ingredientPrinciples}
      cta={{ label: 'VOIR TOUTE LA GAMME →', href: '/gamme' }}
    />

    <JournalTeaser />
  </main>

  <Footer />
</BaseLayout>
