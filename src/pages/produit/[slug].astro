---
/**
 * PDP dynamique — les 5 produits de la gamme hors N°03 Huile (qui garde sa
 * fiche crafted /huile/no-01). Galerie photos Shopify + bloc achat + onglets +
 * avis (maison, AvisProduit) + cross-sell « compléter le rituel ».
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoticeBar from '../../components/NoticeBar.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';
import QuantitySelector from '../../components/QuantitySelector.astro';
import Accordion from '../../components/Accordion.astro';
import ProductCard from '../../components/ProductCard.astro';
import AvisProduit from '../../components/AvisProduit.astro';
import BarreAchat from '../../components/BarreAchat.astro';
import Input from '../../components/Input.astro';
import { getProduct, productList, gammeList, productLabel } from '../../lib/products';
import { productGidForSlug } from '../../lib/reviews';
import { buildPdpTabs } from '../../lib/pdp-tabs';
import { isStoreOpen } from '../../lib/store-status';

export function getStaticPaths() {
  return productList()
    .filter((p) => p.slug !== 'no-01')
    .map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const product = getProduct(slug!)!;
const storeOpen = isStoreOpen();
const tabs = buildPdpTabs(product);
const label = productLabel(product);
const reviewProductId = productGidForSlug(product.slug);

const related = gammeList().filter((p) => p.slug !== product.slug).slice(0, 3);
---

<BaseLayout
  title={`${product.title} — ${product.number ?? 'Solaire'} · PAOLISA`}
  description={product.shortDescription}
>
  <NoticeBar message="LIVRAISON OFFERTE DÈS 60 € EN UE · RETOURS SOUS 30 JOURS" />
  <Header transparent={false} currentPath="/gamme" />

  <main>
    <section class="container-paolisa pt-8 md:pt-12 pb-20 md:pb-32">
      {/*
        Sur mobile, l'ordre est photo principale, bloc d'achat, puis photos
        secondaires : le nom et le prix doivent apparaître dès le premier
        écran. Sur desktop, la mise en page d'origine est conservée, la
        colonne de droite couvrant les deux rangées.
      */}
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-x-16 md:gap-y-4">
        {/* Photo principale */}
        <div class="order-1 md:order-none md:col-span-7">
          <div class="relative w-full aspect-square md:aspect-[4/5] overflow-hidden arch bg-bg-tertiary">
            <img src={product.images[0]} alt={product.title} class="absolute inset-0 w-full h-full object-cover" />
          </div>
        </div>

        {/* Bloc info — sticky desktop */}
        <aside class="order-2 md:order-none md:col-span-5 md:row-span-2">
          <div class="md:sticky md:top-[120px] md:max-w-md">
            <p class="mono-label mb-4">{label} / {product.category}</p>
            <h1 class="display-m mb-1">{product.title}</h1>
            <p class="body-m text-ink-tertiary mb-4">{product.subtitle}</p>
            <p class="mono-label text-ink-tertiary mb-4">{product.format}</p>

            <p class="font-mono text-[18px] tracking-[0.05em] text-ink-primary mb-3">
              {product.priceLabel}
            </p>

            {/*
              La note remonte à côté du prix. Pour une marque encore inconnue,
              c'est la seule preuve qu'une autre personne a essayé, et elle
              n'a aucun effet si elle attend en bas de page. Remplie par le
              script d'AvisProduit, à partir du même appel : pas de requête
              supplémentaire, et rien ne s'affiche s'il n'y a aucun avis.
            */}
            {reviewProductId && (
              <a href="#avis" class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-8 group">
                <span class="font-mono text-[13px] tracking-[0.05em] text-ink-primary hidden" data-avis-note-haut />
                <span class="mono-label text-ink-tertiary group-hover:text-ink-primary">→ LIRE LES AVIS</span>
              </a>
            )}

            <p class="body-l text-ink-secondary mb-8 max-w-prose">
              {product.longDescription}
            </p>

            <ul class="space-y-2 mb-10 body-m">
              {product.actives.map((a) => <li>· {a}</li>)}
            </ul>

            {
              product.comingSoon ? (
                <div id="restock-block" class="border border-line-subtle p-6 md:p-8 mb-6">
                  <p class="mono-label mb-3">— BIENTÔT DISPONIBLE —</p>
                  <p class="body-l text-ink-secondary mb-6">
                    Ce produit rejoint la gamme LA NOTTE le 16 septembre. Laissez votre email pour être prévenue dès sa sortie.
                  </p>

                  <div data-restock-ok class="hidden border-t border-line-subtle pt-4 mb-6" role="status">
                    <p class="mono-label text-ink-primary mb-1">— BIEN REÇU —</p>
                    <p class="body-m text-ink-secondary">Vous serez prévenue par email dès la sortie de ce produit.</p>
                  </div>
                  <div data-restock-erreur class="hidden border-t border-line-subtle pt-4 mb-6" role="alert">
                    <p class="mono-label text-ink-primary mb-1">— ERREUR —</p>
                    <p class="body-m text-ink-secondary">Vérifiez votre adresse email et réessayez.</p>
                  </div>

                  <form method="post" action="/api/newsletter" class="space-y-4" data-restock-form>
                    <input type="hidden" name="source" value="waitlist" />
                    <input type="hidden" name="return" value={product.href} />
                    <input type="hidden" name="product" value={product.title} />
                    <input type="hidden" name="group" value={product.tier} />
                    <div>
                      <label class="sr-only" for="restock-email-nuit">Votre email</label>
                      <Input
                        type="email"
                        name="email"
                        id="restock-email-nuit"
                        placeholder="VOTRE EMAIL"
                        required
                        ariaLabel="Votre adresse email"
                        autocomplete="email"
                      />
                    </div>
                    <Button variant="primary" type="submit" fullWidth>
                      ME PRÉVENIR À LA SORTIE →
                    </Button>
                  </form>
                </div>
              ) : storeOpen && product.available ? (
                <>
                  <form
                    class="mb-6"
                    data-add-to-cart
                    data-variant={product.shopifyVariantId}
                    data-slug={product.slug}
                    data-title={product.title}
                    data-price={product.priceCents}
                    data-image={product.cardImage}
                    data-href={product.href}
                  >
                    <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6 mb-6">
                      <span class="mono-label text-ink-tertiary">QUANTITÉ</span>
                      <QuantitySelector initial={1} max={9} name="quantity" />
                    </div>
                    <Button variant="primary" type="submit" fullWidth>
                      AJOUTER AU PANIER →
                    </Button>
                  </form>
                  <p class="mono-micro text-ink-tertiary">
                    LIVRAISON UNION EUROPÉENNE &nbsp;·&nbsp; RETOURS SOUS 30 JOURS
                  </p>
                </>
              ) : storeOpen && !product.available ? (
                <div id="restock-block" class="border border-line-subtle p-6 md:p-8 mb-6">
                  <p class="mono-label mb-3">— ÉPUISÉ —</p>
                  <p class="body-l text-ink-secondary mb-6">
                    Cette pièce est en rupture pour le moment. Laissez votre email pour être prévenue dès son retour.
                  </p>

                  <div data-restock-ok class="hidden border-t border-line-subtle pt-4 mb-6" role="status">
                    <p class="mono-label text-ink-primary mb-1">— BIEN REÇU —</p>
                    <p class="body-m text-ink-secondary">Vous serez prévenue par email dès que ce produit revient en stock.</p>
                  </div>
                  <div data-restock-erreur class="hidden border-t border-line-subtle pt-4 mb-6" role="alert">
                    <p class="mono-label text-ink-primary mb-1">— ERREUR —</p>
                    <p class="body-m text-ink-secondary">Vérifiez votre adresse email et réessayez.</p>
                  </div>

                  <form method="post" action="/api/newsletter" class="space-y-4" data-restock-form>
                    <input type="hidden" name="source" value="waitlist" />
                    <input type="hidden" name="return" value={product.href} />
                    <input type="hidden" name="product" value={product.title} />
                    <input type="hidden" name="group" value={product.tier} />
                    <div>
                      <label class="sr-only" for="restock-email">Votre email</label>
                      <Input
                        type="email"
                        name="email"
                        id="restock-email"
                        placeholder="VOTRE EMAIL"
                        required
                        ariaLabel="Votre adresse email"
                        autocomplete="email"
                      />
                    </div>
                    <Button variant="primary" type="submit" fullWidth>
                      ME PRÉVENIR DU RETOUR →
                    </Button>
                  </form>
                </div>
              ) : (
                <div id="restock-block" class="border border-line-subtle p-6 md:p-8 mb-6">
                  <p class="mono-label mb-3">— BIENTÔT DISPONIBLE —</p>
                  <p class="body-l text-ink-secondary mb-6">
                    Ce produit rejoint bientôt la boutique. Laissez votre email pour être prévenue à sa sortie.
                  </p>

                  <div data-restock-ok class="hidden border-t border-line-subtle pt-4 mb-6" role="status">
                    <p class="mono-label text-ink-primary mb-1">— BIEN REÇU —</p>
                    <p class="body-m text-ink-secondary">Vous serez prévenue par email dès la sortie de ce produit.</p>
                  </div>
                  <div data-restock-erreur class="hidden border-t border-line-subtle pt-4 mb-6" role="alert">
                    <p class="mono-label text-ink-primary mb-1">— ERREUR —</p>
                    <p class="body-m text-ink-secondary">Vérifiez votre adresse email et réessayez.</p>
                  </div>

                  <form method="post" action="/api/newsletter" class="space-y-4" data-restock-form>
                    <input type="hidden" name="source" value="waitlist" />
                    <input type="hidden" name="return" value={product.href} />
                    <input type="hidden" name="product" value={product.title} />
                    <input type="hidden" name="group" value={product.tier} />
                    <div>
                      <label class="sr-only" for="restock-email-2">Votre email</label>
                      <Input
                        type="email"
                        name="email"
                        id="restock-email-2"
                        placeholder="VOTRE EMAIL"
                        required
                        ariaLabel="Votre adresse email"
                        autocomplete="email"
                      />
                    </div>
                    <Button variant="primary" type="submit" fullWidth>
                      ME PRÉVENIR À LA SORTIE →
                    </Button>
                  </form>
                </div>
              )
            }

            <a href="/diagnostic" class="mono-label text-ink-tertiary hover:text-ink-primary block">
              PAS SÛRE QUE CE SOIT LE BON PRODUIT ? → FAIRE LE DIAGNOSTIC
            </a>
          </div>
        </aside>

        {/* Photos secondaires */}
        {product.images.length > 1 && (
          <div class="order-3 md:order-none md:col-span-7">
            <div class="grid grid-cols-2 gap-3 md:gap-4">
              {product.images.slice(1).map((src, i) => (
                <div class="relative w-full aspect-square overflow-hidden bg-bg-tertiary">
                  <img src={src} alt={`${product.title} — vue ${i + 2}`} class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

      <script is:inline>
        (function () {
          var params = new URLSearchParams(window.location.search);
          var status = params.get('newsletter');
          if (status !== 'ok' && status !== 'erreur') return;

          var ok = document.querySelector('[data-restock-ok]');
          var erreur = document.querySelector('[data-restock-erreur]');
          var form = document.querySelector('[data-restock-form]');
          if (status === 'ok' && ok) {
            ok.classList.remove('hidden');
            form && form.classList.add('hidden');
          } else if (status === 'erreur' && erreur) {
            erreur.classList.remove('hidden');
          }

          var block = document.getElementById('restock-block');
          block && block.scrollIntoView({ behavior: 'smooth', block: 'center' });

          // Nettoie l'URL comme sur /huile/no-01 — sans ça, le Footer (qui lit
          // aussi ?newsletter=) ignore cette page (voir handledByPage) mais le
          // paramètre restait dans la barre d'adresse et refaisait apparaître
          // le message à chaque rafraîchissement.
          var cleanUrl = window.location.pathname + window.location.hash;
          window.history.replaceState({}, document.title, cleanUrl);
        })();
      </script>

      {/* Onglets */}
      <div class="mt-20 md:mt-32 grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-16">
        <div class="md:col-span-4">
          <h2 class="display-s mb-3">— LE PRODUIT EN DÉTAIL</h2>
          <p class="mono-label">{label} / {product.category}</p>
        </div>
        <div class="md:col-span-8">
          <Accordion items={tabs} variant="default" />
        </div>
      </div>
    </section>

    {/* Avis clients (maison) */}
    <div id="avis"></div>
    <AvisProduit productId={reviewProductId} />

    {/* Cross-sell — compléter le rituel */}
    <section class="bg-bg-secondary section-y">
      <div class="container-paolisa">
        <div class="flex items-center gap-4 mb-8">
          <p class="mono-label whitespace-nowrap text-ink-primary">— COMPLÉTER LE RITUEL</p>
          <span class="flex-1 border-t border-line-subtle"></span>
          <a href="/gamme" class="mono-label whitespace-nowrap hover:opacity-70">TOUTE LA GAMME →</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-px bg-line-faint border border-line-faint">
          {
            related.map((p) => (
              <ProductCard
                href={p.href}
                image={p.cardImage}
                imageAlt={p.title}
                eyebrow={`${productLabel(p)} / ${p.category}`}
                title={p.title}
                subtitle={p.subtitle}
                price={p.priceLabel}
                status={p.status}
                quickAdd={storeOpen && p.available}
                variantId={p.shopifyVariantId}
                slug={p.slug}
                priceCents={p.priceCents}
                accentColor={p.accentColor}
              />
            ))
          }
        </div>
      </div>
    </section>

    {storeOpen && product.available && (
      <BarreAchat titre={product.title} prix={product.priceLabel} />
    )}
  </main>

  <Footer />
</BaseLayout>
