---
/**
 * Page « La gamme » — l'inventaire complet (6 produits) en deux niveaux :
 *   Les Essentiels (numérotés, ordre du rituel) · Les Solaires (non numérotés).
 * Cartes = photos des flacons (le code couleur ne vit plus que sur le packaging).
 * Ajout rapide au panier activé quand la boutique est ouverte et le produit dispo.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import NoticeBar from '../components/NoticeBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';
import { essentials, solaires, notte, craquages, productLabel } from '../lib/products';
import { isStoreOpen } from '../lib/store-status';

const essentiels = essentials();
const solaireProducts = solaires();
const solaireCols = Math.min(solaireProducts.length, 4) || 1;
const notteProducts = notte();
// 6 produits : 3 colonnes pour deux rangees completes (4 laissait 2 cases vides sur la 2e rangee).
const notteCols = notteProducts.length % 3 === 0 ? 3 : Math.min(notteProducts.length, 4) || 1;
const craquageProducts = craquages();
const craquageCols = Math.min(craquageProducts.length, 4) || 1;
const storeOpen = isStoreOpen();
---

<BaseLayout
  title="La gamme — PAOLISA"
  description="Les six produits Paolisa : le rituel du matin, du sérum à la protection solaire. Sérum éclat, contour des yeux, huile, crème, solaires."
>
  <NoticeBar message="LIVRAISON OFFERTE DÈS 60 € EN UE · RETOURS SOUS 30 JOURS" />
  <Header transparent={false} currentPath="/gamme" />

  <main>
    <section class="container-paolisa pt-8 md:pt-12 pb-16 md:pb-24">
      <div class="flex items-baseline justify-between flex-wrap gap-4 mb-12 md:mb-16">
        <div class="max-w-2xl">
          <p class="mono-label mb-4">— L'INVENTAIRE —</p>
          <h1 class="display-l mb-4">La gamme</h1>
          <p class="body-l text-ink-secondary max-w-prose">
            Le rituel se lit dans l'ordre. Un numéro par geste, le sérum d'abord,
            puis le regard, puis le soin. Les solaires, eux, s'ajoutent au gré des
            saisons. Le soir a son propre rituel, LA NOTTE, pour préparer la peau
            à la nuit.
          </p>
        </div>
        <p class="mono-label">[ 12 PRODUITS ]</p>
      </div>

      {/* Les Essentiels */}
      <div class="flex items-center gap-4 mb-8">
        <p class="mono-label whitespace-nowrap text-ink-primary">LES ESSENTIELS — LE RITUEL</p>
        <span class="flex-1 border-t border-line-subtle"></span>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-line-faint border border-line-faint">
        {
          essentiels.map((p) => (
            <ProductCard
              href={p.href}
              image={p.cardImage}
              imageAlt={p.title}
              eyebrow={`${productLabel(p)} / ${p.category}`}
              title={p.title}
              subtitle={p.subtitle}
              price={p.priceLabel}
              status={p.status}
              quickAdd={storeOpen && p.available}
              variantId={p.shopifyVariantId}
              slug={p.slug}
              priceCents={p.priceCents}
              accentColor={p.accentColor}
            />
          ))
        }
      </div>
      <p class="mono-micro text-ink-tertiary mt-4">
        N°03 — DEUX TEXTURES POUR LA MÊME ÉTAPE : HUILE POUR LES PEAUX QUI AIMENT LE GRAS, CRÈME POUR LES AUTRES.
      </p>

      {/* Les Solaires */}
      <div class="flex items-center gap-4 mb-8 mt-16 md:mt-24">
        <p class="mono-label whitespace-nowrap text-ink-primary">LES SOLAIRES — AU GRÉ DES SAISONS</p>
        <span class="flex-1 border-t border-line-subtle"></span>
      </div>
      <div
        class="grid w-fit max-w-full gap-px bg-line-faint border border-line-faint"
        style={`grid-template-columns: repeat(${solaireCols}, minmax(200px, 284px));`}
      >
        {
          solaireProducts.map((p) => (
            <ProductCard
              href={p.href}
              image={p.cardImage}
              imageAlt={p.title}
              eyebrow={`SOLAIRE / ${p.format}`}
              title={p.title}
              subtitle={p.subtitle}
              price={p.priceLabel}
              status={p.status}
              quickAdd={storeOpen && p.available}
              variantId={p.shopifyVariantId}
              slug={p.slug}
              priceCents={p.priceCents}
              accentColor={p.accentColor}
            />
          ))
        }
      </div>

      {/* LA NOTTE */}
      <div id="la-notte" class="flex items-center gap-4 mb-8 mt-16 md:mt-24 scroll-mt-24">
        <p class="mono-label whitespace-nowrap text-ink-primary">LA NOTTE : LE RITUEL DU SOIR</p>
        <span class="flex-1 border-t border-line-subtle"></span>
      </div>
      <div
        class="notte-grid grid w-full md:w-fit max-w-full gap-px bg-line-faint border border-line-faint"
        style={`--notte-cols: ${notteCols};`}
      >
        {
          notteProducts.map((p) => (
            <ProductCard
              href={p.href}
              image={p.cardImage}
              imageAlt={p.title}
              eyebrow={`${productLabel(p)} / ${p.category}`}
              title={p.title}
              subtitle={p.subtitle}
              price={p.priceLabel}
              status={p.status}
              quickAdd={storeOpen && p.available}
              variantId={p.shopifyVariantId}
              slug={p.slug}
              priceCents={p.priceCents}
              accentColor={p.accentColor}
            />
          ))
        }
      </div>
      <p class="mono-micro text-ink-tertiary mt-4">
        N°02 EST LE CONTOUR DU MATIN, N°07 CELUI DU SOIR. N°03 CRÈME LISSANTE EST LA CRÈME DE JOUR, N°08 CELLE DE NUIT.
      </p>

      {/* Petits Craquages */}
      {
        craquageProducts.length > 0 && (
          <>
            <div class="flex items-center gap-4 mb-8 mt-16 md:mt-24">
              <p class="mono-label whitespace-nowrap text-ink-primary">PETITS CRAQUAGES — ÉDITION LIMITÉE</p>
              <span class="flex-1 border-t border-line-subtle"></span>
              <a href="/petits-craquages" class="mono-label whitespace-nowrap hover:opacity-70">TOUT VOIR →</a>
            </div>
            <div
              class="craquage-grid grid w-full md:w-fit max-w-full gap-px bg-line-faint border border-line-faint"
              style={`--craquage-cols: ${craquageCols};`}
            >
              {
                craquageProducts.map((p) => (
                  <ProductCard
                    href={p.href}
                    image={p.cardImage}
                    imageAlt={p.title}
                    eyebrow={`PETITS CRAQUAGES / ${p.category}`}
                    title={p.title}
                    subtitle={p.subtitle}
                    price={p.priceLabel}
                    status={p.status}
                    quickAdd={storeOpen && p.available}
                    variantId={p.shopifyVariantId}
                    slug={p.slug}
                    priceCents={p.priceCents}
                    accentColor={p.accentColor}
                  />
                ))
              }
            </div>
          </>
        )
      }
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* LA NOTTE : 2 colonnes fluides sur mobile pour tenir sur l'ecran,
     puis le nombre de colonnes calcule (notteCols) a partir de md. */
  .notte-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 768px) {
    .notte-grid {
      grid-template-columns: repeat(var(--notte-cols), minmax(200px, 284px));
    }
  }

  /* PETITS CRAQUAGES : meme logique que LA NOTTE ci-dessus. */
  .craquage-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 768px) {
    .craquage-grid {
      grid-template-columns: repeat(var(--craquage-cols), minmax(200px, 284px));
    }
  }
</style>

