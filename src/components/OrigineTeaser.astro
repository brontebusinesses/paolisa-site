---
/**
 * <OrigineTeaser /> — bloc chaleur sur la home, entre la bande diagnostic et
 * la TrioBar.
 *
 * Version texte seul (août 2026) : la grande photo pleine largeur a été
 * retirée — elle écrasait la page d'accueil et repoussait tout le reste sous
 * la ligne de flottaison. Le fragment d'histoire familiale suffit à casser
 * l'effet catalogue et à envoyer vers /origine, où la photo vit toujours.
 *
 * Mobile d'abord (99% du trafic) : une seule colonne, texte centré.
 */
import Button from './Button.astro';
---

<section class="bg-bg-primary border-t border-line-subtle" aria-label="Notre histoire">
  <div class="container-paolisa section-y">
    <div class="max-w-prose mx-auto text-center">
      <p class="mono-label mb-6">— DE MAIN EN MAIN —</p>
      <h2 class="display-m mb-6">
        Trois prénoms. Trois générations. Une conviction.
      </h2>
      <p class="body-l text-ink-secondary mb-10">
        Paolo, Isabelle, Lisa. Une même famille, italo-belge, et un geste transmis de main en main : l'huile, le matin. PAOLISA est né de là.
      </p>
      <Button variant="secondary" href="/origine">
        DÉCOUVRIR NOTRE HISTOIRE →
      </Button>
    </div>
  </div>
</section>
