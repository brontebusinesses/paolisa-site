---
/**
 * <HeroAccueil /> — hero d'accueil (août 2026).
 *
 * Image éditoriale plein cadre. Le wordmark et la baseline sont incrustés
 * dans la photo, donc le composant n'ajoute aucun titre : un seul appel à
 * l'action, le diagnostic.
 *
 * L'image garde toujours son rectangle entier — rien n'est jamais rogné,
 * quelle que soit la taille d'écran (choix assumé : elle rapetisse sur
 * mobile plutôt que d'être recadrée).
 *   • Desktop : le bouton se pose sur l'image, sous la baseline incrustée.
 *   • Mobile  : le bouton passe sous l'image, sur fond crème.
 *
 * WebP servi en priorité, JPG en repli — c'est la plus grosse image du site.
 */
import Button from './Button.astro';

interface Cta {
  label: string;
  href: string;
}

interface Props {
  image?: string;
  imageWebp?: string;
  imageAlt?: string;
  cta: Cta;
}

const {
  image = '/hero/accueil.jpg',
  imageWebp = '/hero/accueil.webp',
  imageAlt = 'Une femme applique son soin Paolisa devant le miroir de sa salle de bain, la gamme posée sur le plan de travail.',
  cta,
} = Astro.props;
---

<section class="hero-accueil relative bg-bg-primary" aria-label="Accueil">
  <div class="relative">
    <picture>
      <source srcset={imageWebp} type="image/webp" />
      <img
        src={image}
        alt={imageAlt}
        class="hero-img w-full h-auto block"
        loading="eager"
        decoding="async"
      />
    </picture>

    {/* Repère invisible posé au bas du wordmark incrusté dans la photo (66,5 %
        de sa hauteur). Le Header s'en sert pour savoir quand faire réapparaître
        PAOLISA : au moment précis où celui de l'image disparaît sous la barre,
        et pas à un nombre de pixels arbitraire. */}
    <span data-wordmark-cue class="hero-cue" aria-hidden="true"></span>
  </div>

  <div class="hero-cta">
    <Button variant="primary" href={cta.href}>{cta.label}</Button>
  </div>
</section>

<style>
  /* Repère de bascule du wordmark — sans dimension, purement positionnel. */
  .hero-cue {
    position: absolute;
    top: 66.5%;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  /* Mobile : sous l'image, pour ne rien recouvrir sur un petit écran. */
  .hero-cta {
    display: flex;
    justify-content: center;
    padding: 28px 20px 36px;
  }

  @media (min-width: 768px) {
    /* L'image occupe toute la largeur, sans marge de fond : sur certains
       portables le bas de la photo (le plan de travail) passe donc sous la
       ligne de flottaison. C'est assumé — le wordmark, la baseline et le
       bouton, eux, restent visibles sans scroller. */

    /* Posé sur l'image, sous la baseline incrustée. */
    .hero-cta {
      position: absolute;
      left: 50%;
      bottom: 12%;
      transform: translateX(-50%);
      padding: 0;
    }
  }
</style>
