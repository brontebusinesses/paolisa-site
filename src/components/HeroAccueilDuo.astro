---
/**
 * <HeroAccueilDuo /> — hero d'accueil « duo jour/nuit » (15/09/2026).
 *
 * Remplace le hero photo unique (<HeroAccueil />, conservé mais plus utilisé
 * sur la home) : présente d'emblée les deux rituels, LE MATIN et LA NOTTE,
 * côte à côte avec leurs vrais produits en photo détourée. Chaque moitié est
 * un seul lien cliquable vers la gamme correspondante.
 *
 * Fond : bulle organique pêche (jour) / lavande (nuit), contour encre —
 * fidèle aux mockups validés par Bronté (v20 à v25), pas une réinterprétation
 * avec les tokens existants (tentative faite le 15/09, rejetée : « ça ne
 * ressemble pas à ce qu'on a convenu »). PEACH #F7E4D6 et LAVENDER #E3DFF0
 * sont donc deux couleurs nouvelles, ajoutées avec l'accord explicite de
 * Bronté ce jour-là — à documenter dans tailwind.config.js si elles doivent
 * resservir ailleurs. Le contour reprend l'encre de marque (#4B3729).
 *
 * La bulle est un <path> SVG unique (contour irrégulier à 5 harmoniques,
 * même principe que le script Python des mockups), pas un simple ovale : le
 * mot "bulle" dans son sens précis. Deux tracés différents (jour / nuit),
 * en dur (pas de génération aléatoire côté client).
 *
 * Tailles relatives des flacons calées à la main par Bronté (retour vocal,
 * 09/2026) : le tonique et la mousse sont les plus grands (~1 / 0.98), le
 * contour nuit le plus petit (~0.51), la crème lissante domine le jour
 * (~0.88), sérum et stick solaire similaires (~0.59 / 0.58) — une seule
 * échelle commune aux deux côtés pour rester proportionnel matin/soir.
 *
 * Le CTA diagnostic qui vivait ici (rejeté par Bronté, « on ne le voit
 * pas ») a été déplacé plus bas sur la home, juste sous « Découvrir toute
 * la gamme » : voir <DiagnosticTeaser /> dans index.astro.
 */
interface Props {
  notteStatus?: string;
}
const { notteStatus = 'DISPONIBLE LE 16.09' } = Astro.props;

