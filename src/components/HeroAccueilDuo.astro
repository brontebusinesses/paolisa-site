  'M244.9 100.0 L242.3 105.3 L238.5 110.2 L234.1 114.8 L229.4 119.1 L224.8 123.0 L220.2 126.7 L215.8 130.1 L211.3 133.3 L206.9 136.3 L202.5 139.0 L198.2 141.6 L194.2 144.2 L190.7 146.9 L187.7 150.0 L185.0 153.3 L182.6 157.0 L180.0 160.8 L177.0 164.3 L173.4 167.4 L169.1 169.8 L164.4 171.4 L159.2 172.3 L154.0 172.7 L148.9 173.0 L144.0 173.5 L139.3 174.3 L134.6 175.6 L129.9 177.0 L125.0 178.4 L120.0 179.4 L114.9 179.7 L109.8 179.3 L104.9 178.2 L100.1 176.7 L95.5 174.9 L91.0 173.2 L86.5 171.6 L81.8 170.3 L77.1 169.0 L72.4 167.7 L67.7 166.0 L63.2 164.1 L59.0 161.7 L55.0 159.2 L51.1 156.5 L47.2 153.8 L43.1 151.1 L38.8 148.4 L34.6 145.5 L30.7 142.3 L27.4 138.7 L25.2 134.6 L24.1 130.2 L24.1 125.5 L24.9 120.9 L25.9 116.4 L26.7 112.1 L26.7 108.0 L25.7 104.1 L23.6 100.0 L20.9 95.7 L17.8 91.2 L14.9 86.3 L12.5 81.3 L11.0 76.1 L10.5 70.8 L10.7 65.6 L11.8 60.5 L13.5 55.5 L15.8 50.7 L18.8 46.1 L22.7 42.0 L27.5 38.6 L33.2 35.9 L39.6 34.1 L46.4 33.0 L53.4 32.6 L60.1 32.4 L66.3 32.2 L72.0 31.8 L77.1 31.0 L81.9 29.9 L86.6 28.7 L91.4 27.8 L96.3 27.4 L101.2 27.6 L106.2 28.5 L111.0 29.9 L115.6 31.4 L120.0 32.8 L124.2 33.7 L128.4 34.1 L132.7 34.0 L137.2 33.7 L141.8 33.3 L146.5 33.2 L151.1 33.5 L155.7 34.3 L160.1 35.4 L164.6 36.7 L169.1 38.0 L173.7 39.3 L178.6 40.7 L183.6 42.1 L188.5 43.8 L193.2 45.9 L197.6 48.5 L201.5 51.4 L205.2 54.6 L208.8 58.0 L212.7 61.3 L217.0 64.6 L222.0 67.9 L227.5 71.4 L233.1 75.1 L238.3 79.4 L242.5 84.1 L245.1 89.2 L245.9 94.6 Z';
---

<section class="hero-duo bg-bg-primary" aria-label="Les deux rituels, matin et soir">
  <div class="container-paolisa pt-4 md:pt-8 pb-10 md:pb-14">
    <div class="hero-duo-cols">
      {/* ===================== JOUR ===================== */}
      <a
        href="/gamme"
        class="hero-duo-panel group"
        aria-label="Découvrir le rituel du matin"
      >
        <p class="mono-label text-ink-tertiary mb-4 md:mb-6">LA GAMME DU MATIN</p>

        <div class="hero-duo-blobbox hero-duo-blobbox--day">
          <svg class="hero-duo-blob" viewBox="0 0 246 200" preserveAspectRatio="none" aria-hidden="true">
            <path d={BLOB_DAY} fill="#F7E4D6" stroke="#4B3729" stroke-width="1" stroke-linejoin="round" />
          </svg>

          <div class="hero-duo-content">
            <div class="hero-duo-lineup">
              <img src="/hero/duo/serum.png" alt="" class="hero-duo-img hero-duo-img--serum" loading="eager" width="332" height="900" />
              <img src="/hero/duo/creme-lissante.png" alt="" class="hero-duo-img hero-duo-img--creme" loading="eager" width="247" height="900" />
              <img src="/hero/duo/stick-solaire.png" alt="" class="hero-duo-img hero-duo-img--stick" loading="eager" width="267" height="900" />
            </div>

            <p class="display-s mt-6 md:mt-8">Niacinamide, alternative au rétinol, SPF.</p>
            <span class="hero-duo-pill">LE RITUEL DU MATIN</span>
            <p class="mono-label text-ink-tertiary mt-4 underline underline-offset-4 decoration-[0.5px] group-hover:opacity-70 transition-opacity duration-150 ease-in-out">
              Voir les 6 références
            </p>
          </div>
        </div>
      </a>

      {/* ===================== NUIT (LA NOTTE) ===================== */}
      <a
        href="/gamme#la-notte"
        class="hero-duo-panel group"
        aria-label="Découvrir LA NOTTE, le rituel du soir"
      >
        <p class="mono-label text-ink-tertiary mb-4 md:mb-6 flex items-center gap-3">
          <span class="hero-duo-badge">NOUVEAU</span>
          LA NOTTE — LE RITUEL DU SOIR
        </p>

        <div class="hero-duo-blobbox hero-duo-blobbox--night">
          <svg class="hero-duo-blob" viewBox="0 0 246 200" preserveAspectRatio="none" aria-hidden="true">
            <path d={BLOB_NIGHT} fill="#E3DFF0" stroke="#4B3729" stroke-width="1" stroke-linejoin="round" />
          </svg>

          <div class="hero-duo-content">
            <div class="hero-duo-lineup">
              <img src="/hero/duo/mousse.png" alt="" class="hero-duo-img hero-duo-img--mousse" loading="eager" width="279" height="900" />
              <img src="/hero/duo/contour-nuit.png" alt="" class="hero-duo-img hero-duo-img--contour" loading="eager" width="276" height="653" />
              <img src="/hero/duo/tonique.png" alt="" class="hero-duo-img hero-duo-img--tonique" loading="eager" width="261" height="900" />
            </div>

            <p class="display-s mt-6 md:mt-8">Nourrissant, protection du collagène.</p>
            <p class="mono-label text-ink-tertiary mt-2 mb-4">{notteStatus}</p>
            <span class="hero-duo-pill">LE RITUEL DU SOIR</span>
            <p class="mono-label text-ink-tertiary mt-4 underline underline-offset-4 decoration-[0.5px] group-hover:opacity-70 transition-opacity duration-150 ease-in-out">
              Voir les 6 références
            </p>
          </div>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .hero-duo-panel {
    display: block;
    transition: opacity 150ms ease-in-out;
  }
  .hero-duo-panel:hover {
    opacity: 0.9;
  }

  .hero-duo-cols {
    display: grid;
    grid-template-columns: 1fr;
    row-gap: 56px;
  }

  .hero-duo-blobbox {
    position: relative;
  }

  .hero-duo-blob {
    position: absolute;
    top: -18px;
    left: 0;
    width: 100%;
    height: calc(100% + 36px);
    z-index: 0;
    pointer-events: none;
  }

  .hero-duo-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 34px 24px 40px;
  }

  .hero-duo-lineup {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 18px;
  }

  .hero-duo-img {
    width: auto;
    filter: drop-shadow(0 10px 10px rgba(75, 55, 41, 0.18));
  }

  .hero-duo-img--serum { height: 110px; }
  .hero-duo-img--creme { height: 164px; }
  .hero-duo-img--stick { height: 108px; }
  .hero-duo-img--mousse { height: 182px; }
  .hero-duo-img--contour { height: 94px; }
  .hero-duo-img--tonique { height: 186px; }

  .hero-duo-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 22px;
    padding: 13px 22px;
    background: #4b3729;
    color: #fbf8f1;
    font-family: '"JetBrains Mono"', ui-monospace, monospace;
    font-size: 0.625rem;
    letter-spacing: 0.18em;
  }

  .hero-duo-badge {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border-radius: 999px;
    background: #ff6b5e;
    color: #fff;
    font-family: '"JetBrains Mono"', ui-monospace, monospace;
    font-size: 0.59375rem;
    letter-spacing: 0.18em;
  }

  @media (max-width: 767px) {
    .hero-duo-blobbox { min-height: 460px; }
  }

  @media (min-width: 768px) {
    .hero-duo-cols {
      grid-template-columns: 1fr 1fr;
      column-gap: 0;
      row-gap: 0;
      align-items: start;
    }

    .hero-duo-blobbox { min-height: 620px; }

    /* Les deux bulles se chevauchent au centre, comme sur le mockup :
       chacune déborde de ~14% vers l'autre moitié. Le calque décoratif
       (pointer-events:none) ne perturbe jamais le clic sur l'autre lien. */
    .hero-duo-blobbox--day .hero-duo-blob {
      left: -4%;
      width: 122%;
    }
    .hero-duo-blobbox--night .hero-duo-blob {
      left: auto;
      right: -4%;
      width: 122%;
    }
    .hero-duo-panel:last-child { position: relative; z-index: 1; }
    .hero-duo-panel:first-child { position: relative; z-index: 0; }

    .hero-duo-lineup { gap: 36px; }
    .hero-duo-img--serum { height: 172px; }
    .hero-duo-img--creme { height: 258px; }
    .hero-duo-img--stick { height: 170px; }
    .hero-duo-img--mousse { height: 286px; }
    .hero-duo-img--contour { height: 148px; }
    .hero-duo-img--tonique { height: 292px; }
  }
</style>
