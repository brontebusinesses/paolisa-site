---
/**
 * <HeroAccueilDuo /> — hero d'accueil « duo jour/nuit » (15/09/2026).
 *
 * Fidèle au mockup final validé par Bronté (v25) : deux grandes bulles
 * organiques pêche/lavande qui se chevauchent au centre, quasiment pleine
 * hauteur, avec les produits ET le texte (accroche, bouton, lien) posés
 * DANS la bulle plutôt qu'en dessous. Chaque moitié reste un seul lien
 * cliquable vers la gamme correspondante.
 *
 * Ajustement du 15/09 (2e retour de Bronté, "fais comme les previews") :
 * la première version en code était bien plus petite et sage que le
 * mockup (bulles réduites, séparées par une ligne, pas de bouton) — ce
 * fichier corrige ça pour coller vraiment à l'image de référence.
 *
 * PEACH #F7E4D6 / LAVENDER #E3DFF0 : couleurs nouvelles, accord explicite
 * de Bronté le 15/09/2026 (voir commit précédent). Contour encre #4B3729.
 *
 * Le CTA diagnostic (rejeté par Bronté en haut du hero, "on ne le voit
 * pas") vit maintenant sous "Découvrir toute la gamme" : voir
 * <DiagnosticTeaser /> dans index.astro. Les pastilles "LE RITUEL DU
 * MATIN/SOIR" ici sont décoratives (span, pas un lien) : tout le panneau
 * est déjà cliquable, un <a> imbriqué serait invalide en HTML.
 */
interface Props {
  notteStatus?: string;
}
const { notteStatus = 'DISPONIBLE LE 16.09' } = Astro.props;

