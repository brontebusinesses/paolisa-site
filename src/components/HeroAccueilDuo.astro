<section class="hero-duo bg-bg-primary" aria-label="Les deux rituels, matin et soir">
  <div class="container-paolisa pt-8 md:pt-14 pb-12 md:pb-16">
    <div class="grid md:grid-cols-2 md:divide-x md:divide-line-subtle">
      {/* ===================== JOUR ===================== */}
      <a
        href="/gamme"
        class="hero-duo-panel group flex flex-col items-center text-center pb-10 md:pb-0 md:pr-12"
        aria-label="Découvrir le rituel du matin"
      >
        <p class="mono-label text-ink-tertiary mb-6">LA GAMME DU MATIN</p>

        <div class="hero-duo-frame w-full">
          <svg class="hero-duo-blob" viewBox="0 0 246 200" preserveAspectRatio="none" aria-hidden="true">
            <path d={BLOB_DAY} fill="#F7E4D6" stroke="#4B3729" stroke-width="1.1" stroke-linejoin="round" />
          </svg>
          <div class="hero-duo-lineup">
            <img src="/hero/duo/serum.png" alt="" class="hero-duo-img hero-duo-img--serum" loading="eager" width="332" height="900" />
            <img src="/hero/duo/creme-lissante.png" alt="" class="hero-duo-img hero-duo-img--creme" loading="eager" width="247" height="900" />
            <img src="/hero/duo/stick-solaire.png" alt="" class="hero-duo-img hero-duo-img--stick" loading="eager" width="267" height="900" />
          </div>
        </div>

        <p class="display-s mt-8 max-w-[26ch]">Niacinamide, alternative au rétinol, SPF.</p>
        <p class="mono-label text-ink-tertiary mt-5 group-hover:opacity-70 transition-opacity duration-150 ease-in-out">
          VOIR LES 6 RÉFÉRENCES &nbsp;→
        </p>
      </a>

      {/* ===================== NUIT (LA NOTTE) ===================== */}
      <a
        href="/gamme#la-notte"
        class="hero-duo-panel group flex flex-col items-center text-center pt-12 pb-2 md:pt-0 md:pl-12 border-t md:border-t-0 border-line-subtle"
        aria-label="Découvrir LA NOTTE, le rituel du soir"
      >
        <p class="mono-label text-ink-tertiary mb-6 flex items-center gap-3">
          <span class="hero-duo-badge">NOUVEAU</span>
          LA NOTTE — LE RITUEL DU SOIR
        </p>

        <div class="hero-duo-frame w-full">
          <svg class="hero-duo-blob" viewBox="0 0 246 200" preserveAspectRatio="none" aria-hidden="true">
            <path d={BLOB_NIGHT} fill="#E3DFF0" stroke="#4B3729" stroke-width="1.1" stroke-linejoin="round" />
          </svg>
          <div class="hero-duo-lineup">
            <img src="/hero/duo/mousse.png" alt="" class="hero-duo-img hero-duo-img--mousse" loading="eager" width="279" height="900" />
            <img src="/hero/duo/contour-nuit.png" alt="" class="hero-duo-img hero-duo-img--contour" loading="eager" width="276" height="653" />
            <img src="/hero/duo/tonique.png" alt="" class="hero-duo-img hero-duo-img--tonique" loading="eager" width="261" height="900" />
          </div>
        </div>

        <p class="display-s mt-8 max-w-[26ch]">Nourrissant, protection du collagène.</p>
        <p class="mono-label text-ink-tertiary mt-3">{notteStatus}</p>
        <p class="mono-label text-ink-tertiary mt-5 group-hover:opacity-70 transition-opacity duration-150 ease-in-out">
          VOIR LES 6 RÉFÉRENCES &nbsp;→
        </p>
      </a>
    </div>
  </div>
</section>

<style>
  .hero-duo-panel {
    transition: opacity 150ms ease-in-out;
  }
  .hero-duo-panel:hover {
    opacity: 0.85;
  }

  .hero-duo-frame {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    height: 260px;
  }

  .hero-duo-blob {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero-duo-lineup {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 22px;
    padding-bottom: 8%;
  }

  .hero-duo-img {
    width: auto;
    filter: drop-shadow(0 10px 10px rgba(75, 55, 41, 0.18));
  }

  /* Jour — une seule échelle commune avec la nuit (tonique = référence). */
  .hero-duo-img--serum { height: 100px; }
  .hero-duo-img--creme { height: 149px; }
  .hero-duo-img--stick { height: 98px; }

  /* Nuit */
  .hero-duo-img--mousse { height: 166px; }
  .hero-duo-img--contour { height: 86px; }
  .hero-duo-img--tonique { height: 170px; }

  .hero-duo-badge {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border-radius: 999px;
    background: #ff6b5e;
    color: #fff;
    font-family: '"JetBrains Mono"', ui-monospace, monospace;
    font-size: 0.59375rem;
    letter-spacing: 0.18em;
  }

  @media (min-width: 768px) {
    .hero-duo-frame {
      height: 380px;
    }
    .hero-duo-lineup {
      gap: 40px;
    }
    .hero-duo-img--serum { height: 177px; }
    .hero-duo-img--creme { height: 264px; }
    .hero-duo-img--stick { height: 174px; }
    .hero-duo-img--mousse { height: 294px; }
    .hero-duo-img--contour { height: 152px; }
    .hero-duo-img--tonique { height: 300px; }
  }
</style>
